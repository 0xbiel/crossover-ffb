#!/bin/zsh
set -eu
cd "${0:A:h:h}"
mkdir -p .build/clang-cache .build/swiftpm-cache
export CLANG_MODULE_CACHE_PATH="$PWD/.build/clang-cache"
# The default swiftbuild backend records SDK 13.0 in the binary, so AppKit draws legacy controls.
exec swift "${1:-build}" --build-system native --cache-path "$PWD/.build/swiftpm-cache" --scratch-path .build --disable-sandbox

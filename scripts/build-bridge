#!/bin/zsh
# Build the Win64 and Win32 dinput8.dll bridges and run the offline unit tests.
set -eu
cd "${0:A:h:h}"
# Needs Homebrew LLVM (clang, llvm-dlltool, llvm-readobj) and a COFF linker: lld-link
# (`brew install llvm lld`) or the rust-lld that ships with a rustup toolchain.
llvm_bin=${LLVM_BIN:-$(brew --prefix llvm 2>/dev/null || print /opt/homebrew/opt/llvm)/bin}
[[ -x "$llvm_bin/clang" ]] || { print -u2 "LLVM not found; run: brew install llvm lld (or set LLVM_BIN)"; exit 1 }
link=()
for candidate in "$(command -v lld-link || true)" "$llvm_bin/lld-link" "$(brew --prefix lld 2>/dev/null)/bin/lld-link"; do
    [[ -n "$candidate" && -x "$candidate" ]] && { link=("$candidate"); break }
done
if (( ! ${#link} )); then
    for rust_lld in $HOME/.rustup/toolchains/*/lib/rustlib/*/bin/rust-lld(N); do
        link=(env "DYLD_LIBRARY_PATH=${rust_lld:h:h:h:h}" "$rust_lld" -flavor link); break
    done
fi
(( ${#link} )) || { print -u2 "No COFF linker found; run: brew install lld"; exit 1 }
mkdir -p bridge/build
/usr/bin/clang -std=c11 -g -Wall -Wextra -Wno-unused-function -Wno-missing-field-initializers -fsanitize=address,undefined bridge/tests/test_bridge.c -o bridge/build/test-bridge
bridge/build/test-bridge
"$llvm_bin/clang" --target=x86_64-pc-windows-msvc -std=c11 -O2 -ffreestanding -fno-builtin -fno-stack-protector -Wall -Wextra -Werror -c bridge/observe.c -o bridge/build/observe.obj
"$llvm_bin/llvm-dlltool" -m i386:x86-64 -d bridge/kernel32.def -l bridge/build/kernel32.lib
"${link[@]}" /Brepro /dll /nodefaultlib /machine:x64 /entry:DllMain /dynamicbase /nxcompat /out:bridge/build/dinput8.dll /def:bridge/exports.def bridge/build/observe.obj bridge/build/kernel32.lib
"$llvm_bin/llvm-readobj" --file-headers --coff-imports --coff-exports bridge/build/dinput8.dll > bridge/build/pe-inspection.txt
"$llvm_bin/clang" --target=i686-pc-windows-msvc -march=pentium4 -std=c11 -O2 -ffreestanding -fno-builtin -fno-stack-protector -Wall -Wextra -Werror -c bridge/observe.c -o bridge/build/observe-x86.obj
"$llvm_bin/llvm-dlltool" -m i386 -k -d bridge/kernel32-x86.def -l bridge/build/kernel32-x86.lib
"${link[@]}" /Brepro /dll /nodefaultlib /machine:x86 /entry:DllMain@12 /dynamicbase /nxcompat /out:bridge/build/dinput8-x86.dll /def:bridge/exports-x86.def bridge/build/observe-x86.obj bridge/build/kernel32-x86.lib
"$llvm_bin/llvm-readobj" --file-headers --coff-imports --coff-exports bridge/build/dinput8-x86.dll > bridge/build/pe-inspection-x86.txt
python3 - <<'PY'
from pathlib import Path
for path, arch in [('bridge/build/pe-inspection.txt', 'IMAGE_FILE_MACHINE_AMD64'),
                   ('bridge/build/pe-inspection-x86.txt', 'IMAGE_FILE_MACHINE_I386')]:
    s = Path(path).read_text()
    assert arch in s, f'missing {arch} in {path}'
    assert s.count('Import {') == 1 and 'Name: KERNEL32.dll' in s, f'unexpected imports in {path}'
    for export in ['DirectInput8Create', 'DllCanUnloadNow', 'DllGetClassObject', 'DllRegisterServer', 'DllUnregisterServer']:
        assert export in s, f'missing export {export} in {path}'
print('PASS: x64 + x86 PE dinput8 bridges, KERNEL32-only imports')
PY
print "Built bridge/build/dinput8.dll and bridge/build/dinput8-x86.dll"
